# ─────────────────────────────────────────────────────────────────────────────
# API Connector — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to frontend/.env and fill in real values.
# NEVER commit frontend/.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL — no trailing slash.
# Local:      http://localhost:8000
# Production: https://api.your-domain.com
#
# This value is embedded in the browser bundle at build time (VITE_ prefix).
# It must NOT contain credentials or tokens — only the server origin.
VITE_API_BASE_URL=http://localhost:8000
