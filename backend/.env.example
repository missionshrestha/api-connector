# ─────────────────────────────────────────────────────────────────────────────
# API Connector — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django cryptographic secret key.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Required in all environments. No default. Missing key = startup failure (ImproperlyConfigured).
DJANGO_SECRET_KEY=<generate-a-50-char-random-string>

# Set True for local development only. Never True in production.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Local: localhost,127.0.0.1   Production: your-api-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection URL.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite is NOT supported. Always use PostgreSQL — JSONField maps to JSONB on
# PostgreSQL; on SQLite it degrades to TEXT, causing silent query failures.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/api_connector_dev

# Fernet symmetric encryption key for credential storage at rest.
# SECRETS MANAGER VALUE — store in Vault, AWS Secrets Manager, or GCP Secret Manager.
# NEVER commit a real key to version control.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️  WARNING: Rotating this key invalidates ALL stored encrypted credentials.
#     A key rotation procedure will be documented in docs/operations.md (Phase 8).
#     Do not rotate without following that procedure.
#
ENCRYPTION_KEY=<generate-a-fernet-key>

# Comma-separated list of allowed CORS origins (no trailing slash).
# Must be a list — never use CORS_ALLOW_ALL_ORIGINS = True.
# Local: http://localhost:5173   Production: https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set True to redirect all HTTP to HTTPS. False for local development.
SECURE_SSL_REDIRECT=False

# OAuth 2.0 Authorization Code redirect URI.
# Must exactly match the redirect URI registered in each OAuth provider's app config.
# Local:      http://localhost:8000/api/connector/oauth/callback/
# Production: https://api.your-domain.com/api/connector/oauth/callback/
# NOTE: Used starting Phase 4. Leave as-is until then.
OAUTH_REDIRECT_URI=http://localhost:8000/api/connector/oauth/callback/

# Maximum recursion depth for schema inference. Default: 10.
SCHEMA_INFERENCE_MAX_DEPTH=10